/**
 * ROFI Color theme
 * NAME: luci4.rasi
 * DESCRIPTION: Auto-generated from AwesomeWM luci4 theme.
 * GENERATED: 2026-05-05T15:15:55Z
 */

* {
    background-color:            #101112;
    border-color:                #202324;
    text-color:                  #d0d8da;
    font:                        "Terminess Nerd Font Medium 22";
    prompt-font:                 "UbuntuSans Nerd Font Bold 22";
    prompt-background:           #4980ac;
    prompt-foreground:           #070c11;
    prompt-padding:              4px;
    alternate-normal-background: #0e1922;
    alternate-normal-foreground: #d0d8da;
    selected-normal-background:  #1d3344;
    selected-normal-foreground:  #ffffff;
    spacing:                     3;
}

#window {
    border:  2;
    padding: 5;
    border-radius: 4;
}

#mainbox {
    border:  0;
    padding: 0;
}

#message {
    border:       1px dash 0px 0px;
    padding:      1px;
}

#listview {
    fixed-height: 0;
    border:       2px solid 0px 0px;
    border-color: #0e1922;
    spacing:      2px;
    scrollbar:    true;
    padding:      2px 0px 0px;
}

#element {
    border:  0;
    padding: 3px;
    border-radius: 4;
}

#element.selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

#element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color:       @alternate-normal-foreground;
}

#scrollbar {
    width:        0px;
    border:       0;
    handle-width: 0px;
    padding:      0;
}

#sidebar {
    border: 2px dash 0px 0px;
}

#button.selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

#inputbar {
    spacing:    0;
    padding:    1px;
}

#case-indicator {
    spacing:    0;
}

#entry {
    padding: 4px 4px;
    expand: false;
    width: 10em;
}

#prompt {
    padding:          @prompt-padding;
    background-color: @prompt-background;
    text-color:       @prompt-foreground;
    font:             @prompt-font;
    border-radius:    4px;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
}

element-icon {
    background-color: inherit;
}
